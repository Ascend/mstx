{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug Active File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/build/python:${workspaceFolder}/build/c:${workspaceFolder}:${env:PYTHONPATH}",
        "LD_LIBRARY_PATH": "${workspaceFolder}/build/c:${env:LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "Python: Pytest Case Debugging",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/build_ut_cpp/python:${workspaceFolder}/build_ut_cpp/c:${workspaceFolder}/build/python:${workspaceFolder}/build/c:${workspaceFolder}:${env:PYTHONPATH}",
        "LD_LIBRARY_PATH": "${workspaceFolder}/build_ut_cpp/c:${workspaceFolder}/build/c:${env:LD_LIBRARY_PATH}"
      }
    }
  ]
}
